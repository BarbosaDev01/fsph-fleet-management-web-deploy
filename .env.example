# URL usada pelo navegador. Em desenvolvimento e produção, /api mantém a API na mesma origem.
VITE_API_BASE_URL=/api

# Destino do proxy do Vite. Esta variável só é usada pelo servidor de desenvolvimento.
VITE_API_PROXY_TARGET=http://localhost:8081

# URL do documento OpenAPI usada por `pnpm api:generate`.
# Opcional: por padrão a geração usa openapi/gestao-frotas.json.
OPENAPI_URL=http://localhost:8081/v3/api-docs
